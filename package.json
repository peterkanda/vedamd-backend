{
  "name": "vedamd-backend",
  "version": "0.1.0",
  "private": true,
  "description": "VedaMD — Open-source clinical decision support API (NestJS + Fastify)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "keys:generate": "ts-node --transpile-only scripts/generate-signing-keys.ts",
    "bundle:sign": "ts-node --transpile-only scripts/sign-bundle.ts",
    "bundle:verify": "ts-node --transpile-only scripts/verify-bundle.ts",
    "bundle:check-citations": "node scripts/check-citation-sources.js",
    "bundle:audit-urls": "node scripts/audit-urls.js",
    "openapi:generate": "ts-node --transpile-only scripts/generate-openapi.ts",
    "openapi:check": "ts-node --transpile-only scripts/generate-openapi.ts -- --check",
    "audit:stateless": "ts-node --transpile-only scripts/audit-stateless.ts",
    "ci": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run audit:stateless && npm test"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cql-execution": "^3.0.0",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.11.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
