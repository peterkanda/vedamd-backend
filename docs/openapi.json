    "/api/v1/drugs/{slug}/dosing": {
      "post": {
        "description": "Deterministic algorithm over the structured drug record. Refuses to return a mg dose for individualised regimens (e.g. warfarin) or when CrCl falls in a contraindicated band. Always returns a narrative.",
