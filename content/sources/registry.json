{
  "$schema": "./registry.schema.md",
  "description": "Machine-readable content-source & licence registry. Operationalises the Kenya/SSA CDS content-sourcing analysis: every upstream source carries a licence tier and an embeddable verdict that the ingestion engine and the licence-compliance CI gate enforce. `citationLicence` maps each source onto the shared CitationLicence enum (src/common/citation.ts) so citation hosts can be checked against it. NOTHING is embedded from a source whose embeddable verdict is not 'yes'.",
  "updated": "2026-06-10",
  "tiers": {
    "1": "Safe to embed in a commercial product with attribution (public-domain / permissive).",
    "2": "High value but licence-uncertain — verify per source/repo before embedding.",
    "3": "Free to clinicians but NOT embeddable (NC/ND/proprietary/government) — cite only, author original logic."
  },
