<?xml version="1.0"?>
<tryton>
    <data>
        <!-- VedaMD configuration form (Health -> Configuration -> VedaMD) -->
        <record model="ir.ui.view" id="vedamd_configuration_view_form">
            <field name="model">gnuhealth.vedamd.configuration</field>
            <field name="type">form</field>
            <field name="name">vedamd_configuration_form</field>
        </record>

        <record model="ir.action.act_window" id="act_vedamd_configuration_form">
            <field name="name">VedaMD Configuration</field>
            <field name="res_model">gnuhealth.vedamd.configuration</field>
        </record>

        <record model="ir.action.act_window.view" id="act_vedamd_configuration_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="vedamd_configuration_view_form"/>
            <field name="act_window" ref="act_vedamd_configuration_form"/>
        </record>

        <menuitem
            name="VedaMD Configuration"
            parent="health.gnuhealth_conf_menu"
            action="act_vedamd_configuration_form"
            id="menu_vedamd_configuration"
            icon="tryton-list"/>

        <!-- Only health administrators may see or change the API key. -->
        <record model="ir.model.access" id="access_vedamd_configuration_admin">
            <field name="model">gnuhealth.vedamd.configuration</field>
            <field name="group" ref="health.group_health_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.access" id="access_vedamd_configuration">
            <field name="model">gnuhealth.vedamd.configuration</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
    </data>
</tryton>
