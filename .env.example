# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection — Supabase Cloud, self-hosted Supabase, or any
# Postgres (RDS, Safaricom Cloud, docker-compose local). When unset,
# operator services (API keys, integration log, audit) fall back to
# in-memory storage suitable only for dev / unit tests.
DATABASE_URL=postgresql://vedamd:vedamd_dev_password@localhost:5432/vedamd_dev
DATABASE_POOL_MAX=10
# Set to true for managed Postgres (Supabase / RDS).
DATABASE_SSL=false

# Audit (NFR-029 — HMAC-SHA-256 secret for hashing identifiers before write).
# MUST be set in production. Rotate carefully — rotation invalidates
# correlation across hashed identifiers in historical logs.
AUDIT_HASH_SECRET=change-me-in-prod

# API key fingerprinting (FR-313). HMAC-SHA-256 secret used to fingerprint
# integrator API keys at issue time and on every request. Only the
# fingerprint is stored server-side; the secret itself is shown to the
# integrator exactly once at creation. MUST be set in production.
API_KEY_FINGERPRINT_SECRET=change-me-in-prod

# Content bundle (FR-024, FR-025). Pointed at a directory containing
# manifest.json + manifest.sig + public-key.pem + per-domain JSON files.
# In production CONTENT_STRICT_VERIFICATION defaults to true; any
# verification failure refuses to boot.
CONTENT_BUNDLE_DIR=content/bundles/v0.1.0
CONTENT_STRICT_VERIFICATION=true
# When true the runtime refuses to load any bundle containing
# draft / review / deprecated records (FR-024). Defaults to true in
# production. Keep false in dev so the v0.1 placeholder bundle still
# loads.
CONTENT_REQUIRE_APPROVED=false
# SNOMED CT redistribution requires an affiliate licence. SNOMED data
# ships in the bundle as future provision but is HIDDEN at runtime
# (terminology code system, record `snomed` fields, SNOMED card codings)
# unless this is set to true. Leave unset/false until a licence is in
# place; set to true to surface SNOMED in a licensed deployment.
CONTENT_SNOMED_ENABLED=false

# Operator identity (OIDC). Provider-agnostic: Zitadel, Keycloak,
# self-hosted Supabase Auth (GoTrue), any conformant IdP.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=vedamd-api
# JWT claim that carries the integrator_id. Override per IdP:
#   Zitadel:        usually 'org_id' or a custom claim
#   Keycloak:       usually a custom claim 'integrator_id'
#   Supabase Auth:  'app_metadata.integrator_id' (use the claim
#                    mapping facility to flatten)
OIDC_INTEGRATOR_ID_CLAIM=integrator_id
# DEV ONLY. When true AND NODE_ENV != 'production', the operator
# guard accepts x-integrator-id headers as identity. Production
# rejects this even if set. Disable as soon as an IdP is wired.
OPERATOR_AUTH_DEV_BYPASS=true

# Integration log (SRS §6.3.17 — hard ceilings of 50_000 / 30 days enforced in config)
INTEGRATION_LOG_MAX_ENTRIES=50000
INTEGRATION_LOG_TTL_DAYS=30

# LLM providers (optional; deterministic engine works without these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agentic CDS engine
# Provider routing: anthropic (default) | openai | anthropic-only | openai-only
AGENTIC_PROVIDER=anthropic
# Claude model for the agentic reasoner (default claude-sonnet-4-6)
AGENTIC_ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI / OpenAI-compatible fallback model + base URL
AGENTIC_OPENAI_MODEL=gpt-4o
AGENTIC_OPENAI_BASE_URL=https://api.openai.com/v1
# Concurrency for population/retrospective batch sweeps (1-16, default 4)
AGENTIC_BATCH_CONCURRENCY=4
# Pull-mode SQL ingestion — JSON arrays held server-side only.
# Clients pass connectionId + queryId; never raw SQL or connection strings.
# AGENTIC_SQL_CONNECTIONS=[{"id":"openmrs-prod","dialect":"mysql","url":"mysql://user:pass@host/openmrs","ssl":true,"maxRows":200}]
# AGENTIC_SQL_QUERIES=[{"id":"active-meds","sql":"SELECT drug_name AS med FROM orders WHERE encounter_id = :encounterId AND voided = 0","mapping":{"medicationColumn":"med"}}]
AGENTIC_SQL_CONNECTIONS=[]
AGENTIC_SQL_QUERIES=[]
# Register the built-in EHR schema presets (OpenMRS/Bahmni/openEMR/DHIS2/FHIR-SQL)
# as runnable named queries. Off by default — presets are templates to adapt to
# your local schema first (GET /api/v1/agentic/presets to view them).
AGENTIC_SQL_REGISTER_PRESETS=false
# Optional enterprise DB drivers (peer deps): npm install mysql2 mssql oracledb

# Redis (optional). Shared cache for derived, recomputable values only
# (deterministic CDS results, bundle metadata) — never PHI. When unset,
# CacheService falls back to a per-process in-memory LRU; stateless
# behaviour is preserved either way. ioredis is already a dependency, so
# just setting REDIS_URL activates the shared cache.
#   REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_URL=
REDIS_CDS_TTL_SECONDS=60

# CORS — comma-separated allowlist of frontend origins (scheme + host +
# optional port; NO trailing slash). Include every origin that will
# make browser fetches to this backend: local dev URLs, your
# DigitalOcean frontend URL, and your custom domain + subdomains.
# Example (local + DO + vedamd.io):
#   http://localhost:8080,https://sea-turtle-app-9s2oj.ondigitalocean.app,https://vedamd.io,https://www.vedamd.io,https://app.vedamd.io
CORS_ORIGINS=http://localhost:5173
